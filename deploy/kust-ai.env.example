# =====================================================================
# KUSTSpringAI 生产环境变量模板
#
# 服务器上使用：
#   sudo mkdir -p /etc/kust-ai
#   sudo cp deploy/kust-ai.env.example /etc/kust-ai/kust-ai.env
#   sudo chmod 600 /etc/kust-ai/kust-ai.env
#   sudo vim /etc/kust-ai/kust-ai.env      # 填入真实密钥
#
# 这些变量会覆盖 application.properties 中 ${VAR:默认值} 的默认值
# =====================================================================

# ---- AI（阿里云百炼 DashScope API Key）----
AI_API_KEY=sk-替换为你的百炼API-KEY

# ---- MySQL（对话记忆持久化）----
# 若数据库就在本机且账号密码同默认值，可整段不设（回退 application.properties）
DB_URL=jdbc:mysql://127.0.0.1:3306/kust_spring_ai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=替换为数据库密码

# ---- SMTP 邮箱（QQ邮箱授权码）----
MAIL_USERNAME=替换为发件邮箱@qq.com
MAIL_PASSWORD=替换为SMTP授权码
